<%- include('../partials/__head.ejs') %>

<body>
    <div class="container-scroller">

        <%- include('../partials/__nav.ejs') %>

        <section class="pc-container">
            <div class="pc-content">

                <div class="main-panel">
                    <div class="content-wrapper">

                        <div class="container mt-5">
                            <div class="row">

                                <div class="col-lg-12 grid-margin stretch-card">
                                    <div class="card">
                                        <div class="card-body">

                                            <h4 class="card-title">
                                                Data Periode Fee Rujukan
                                            </h4>

                                            <div class="mb-3">

                                                <a href="/periode/create" class="btn btn-sm btn-info">
                                                    <i class="bi-plus-circle"></i>
                                                    Tambah Periode
                                                </a>

                                                <a href="/periode/rekap" class="btn btn-sm btn-success">
                                                    <i class="bi-bar-chart"></i>
                                                    Rekap Anggaran
                                                </a>

                                            </div>

                                            <% 
                                                const namaBulan = [
                                                    '',
                                                    'Januari',
                                                    'Februari',
                                                    'Maret',
                                                    'April',
                                                    'Mei',
                                                    'Juni',
                                                    'Juli',
                                                    'Agustus',
                                                    'September',
                                                    'Oktober',
                                                    'November',
                                                    'Desember'
                                                ];
                                            %>

                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover">

                                                    <thead>
                                                        <tr>
                                                            <th>No</th>
                                                            <th>Tahun</th>
                                                            <th>Bulan</th>
                                                            <th>No. Periode</th>
                                                            <th>Uang Muka</th>
                                                            <th>Keterangan</th>
                                                            <th>Aksi</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>

                                                        <% if (data.length > 0) { %>

                                                            <% for (let i = 0; i < data.length; i++) { %>

                                                                <tr>

                                                                    <td>
                                                                        <%= i + 1 %>
                                                                    </td>

                                                                    <td>
                                                                        <%= data[i].tahun %>
                                                                    </td>

                                                                    <td>
                                                                        <%= namaBulan[Number(data[i].bulan)] || data[i].bulan %>
                                                                    </td>

                                                                    <td>
                                                                        <%= data[i].nomor_periode %>
                                                                    </td>

                                                                    <td>
                                                                        Rp <%= Number(data[i].uang_muka || 0).toLocaleString('id-ID') %>
                                                                    </td>

                                                                    <td>
                                                                        <%= data[i].keterangan || '-' %>
                                                                    </td>

                                                                    <td>
                                                                        <div class="d-flex">

                                                                            <a href="/periode/edit/<%= data[i].id_periode %>"
                                                                               class="btn btn-sm btn-warning mr-2">
                                                                                <i class="ti ti-edit"></i>
                                                                            </a>

                                                                            <button
                                                                                type="button"
                                                                                class="btn btn-sm btn-danger"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#deleteModal<%= data[i].id_periode %>">
                                                                                <i class="ti ti-trash"></i>
                                                                            </button>

                                                                        </div>
                                                                    </td>

                                                                </tr>

                                                            <% } %>

                                                        <% } else { %>

                                                            <tr>
                                                                <td colspan="7" class="text-center">
                                                                    Belum ada data periode.
                                                                </td>
                                                            </tr>

                                                        <% } %>

                                                    </tbody>

                                                </table>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <!-- Modal Konfirmasi Hapus -->
        <% for (let i = 0; i < data.length; i++) { %>

            <div class="modal fade"
                 id="deleteModal<%= data[i].id_periode %>"
                 tabindex="-1"
                 aria-labelledby="deleteModalLabel<%= data[i].id_periode %>"
                 aria-hidden="true">

                <div class="modal-dialog">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title"
                                id="deleteModalLabel<%= data[i].id_periode %>">
                                Konfirmasi Hapus
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>

                        </div>

                        <div class="modal-body">

                            Apakah Anda yakin ingin menghapus
                            <strong>
                                Periode <%= data[i].nomor_periode %>
                                - <%= namaBulan[Number(data[i].bulan)] || data[i].bulan %>
                                <%= data[i].tahun %>
                            </strong>
                            dari daftar?

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Batal
                            </button>

                            <form action="/periode/delete/<%= data[i].id_periode %>"
                                  method="POST">

                                <button type="submit" class="btn btn-danger">
                                    Ya, Hapus
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        <% } %>

    </div>

    <%- include('../partials/__foot.ejs') %>

</body>