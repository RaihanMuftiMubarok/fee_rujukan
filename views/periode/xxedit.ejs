<%- include('../partials/__head.ejs') %>

    <body>
        <div class="container-scroller d-flex align-items-center justify-content-center" style="min-height: 100vh;">
            <!-- partial:partials/_navbar.html -->
            <!-- partial -->
            <div class="main-panel w-100">
                <div class="content-wrapper d-flex align-items-center justify-content-center">
                    <div class="col-md-6 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Edit Data periode</h4>
                                <p class="card-description">
                                  
                                </p>
                                <form action="/periode/update/<%= id %>" method="POST" 
                                    class="forms-sample">

                                    <div class="form-group mb-2">
                                        <label for="tahun">Tahun</label>
                                        <input type="date" class="form-control" id="tahun" name="tahun"
                                             value="<%= data.tahun %>" required>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label for="bulan">Bulan</label>
                                        <input type="date" class="form-control" id="bulan" name="bulan"
                                             value="<%= data.bulan %>" required>
                                    </div>

                                    <!--  -->
                                    <div class="form-group mb-3">
                                        <label for="nomor_periode">No. Periode</label>
                                        <input type="text" class="form-control" id="nomor_periode" name="nomor_periode"
                                           value="<%= data.nomor_periode %>">
                                    </div>

                                    <!--  -->
                                    <div class="form-group mb-3">
                                        <label for="uang_muka">Uang Muka</label>
                                        <input type="text" class="form-control" id="uang_muka" name="uang_muka"
                                           value="<%= data.uang_muka %>">
                                    </div>

                                    <!--  -->
                                    <div class="form-group mb-3">
                                        <label for="keterangan">Keterangan</label>
                                        <input type="text" class="form-control" id="keterangan" name="keterangan"
                                           value="<%= data.keterangan %>">
                                    </div>


                                    
                                    
                                    <button type="submit" class="btn btn-primary mr-2">Simpan</button>
                                    <button type="button" class="btn btn-light" onclick="history.back()">Cancel</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
        </div>
        <!-- container-scroller ends -->
        <%- include('../partials/__foot.ejs') %>
    </body>

    </html>