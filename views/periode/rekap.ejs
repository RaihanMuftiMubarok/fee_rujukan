
<%- include('../partials/__head.ejs') %>

<%
    const namaBulan = [
        '',
        'Januari',
        'Februari',
        'Maret',
        'April',
        'Mei',
        'Juni',
        'Juli',
        'Agustus',
        'September',
        'Oktober',
        'November',
        'Desember'
    ];

    function formatRupiah(value) {
        return 'Rp ' + Number(value || 0).toLocaleString('id-ID', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    }
%>

<body>

<div class="container-scroller">

    <%- include('../partials/__nav.ejs') %>

    <section class="pc-container">

        <div class="pc-content">

            <div class="main-panel w-100">

                <div class="content-wrapper">

                    <div class="container-fluid mt-3">

                        <div class="row">

                            <div class="col-lg-12 grid-margin stretch-card">

                                <div class="card">

                                    <div class="card-body">

                                        <!-- JUDUL -->
                                        <h4 class="card-title">
                                            Rekap Anggaran Fee Rujukan
                                        </h4>

                                        <p class="card-description">
                                            Ringkasan uang muka, total fee yang sudah dicairkan,
                                            dan sisa anggaran setiap periode.
                                        </p>


                                        <!-- FLASH MESSAGE -->
                                        <% if (typeof success !== 'undefined' && success.length > 0) { %>

                                            <% success.forEach(msg => { %>

                                                <div class="alert alert-success alert-dismissible fade show">

                                                    <%= msg %>

                                                    <button
                                                        type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="alert">
                                                    </button>

                                                </div>

                                            <% }) %>

                                        <% } %>


                                        <% if (typeof error !== 'undefined' && error.length > 0) { %>

                                            <% error.forEach(msg => { %>

                                                <div class="alert alert-danger alert-dismissible fade show">

                                                    <%= msg %>

                                                    <button
                                                        type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="alert">
                                                    </button>

                                                </div>

                                            <% }) %>

                                        <% } %>


                                        <!-- TOMBOL AKSI -->
                                        <div class="mb-3  align-items-center">

                                            <a href="/periode"
                                            class="btn btn-sm btn-secondary mr-2">
                                                <i class="bi-arrow-left"></i>
                                                Kembali ke Data Periode
                                            </a>

                                            <% if (filters.tahun && filters.bulan) { %>

                                                <a
                                                    href="/periode/rekap/export?tahun=<%= filters.tahun %>&bulan=<%= filters.bulan %>"
                                                    class="btn btn-sm btn-success">

                                                    <i class="bi-download"></i>
                                                    Ekspor Excel

                                                </a>

                                            <% } else { %>

                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-success"
                                                    onclick="alert('Silakan pilih bulan dan tahun terlebih dahulu sebelum mengekspor Excel.')"
                                                    title="Pilih tahun dan bulan terlebih dahulu">

                                                    <i class="bi-download"></i>
                                                    Ekspor Excel

                                                </button>

                                            <% } %>

                                        </div>

                                        <!-- FILTER -->
                                        <div class="card border mb-4">

                                            <div class="card-body">

                                                <h5 class="mb-3">
                                                    <i class="bi-filter"></i>
                                                    Filter Rekap Periode
                                                </h5>

                                                <form
                                                    action="/periode/rekap"
                                                    method="GET">

                                                    <div class="row">

                                                        <!-- FILTER TAHUN -->
                                                        <div class="col-md-4 mb-3">

                                                            <label for="filter_tahun">
                                                                Tahun
                                                            </label>

                                                            <select
                                                                class="form-control"
                                                                id="filter_tahun"
                                                                name="tahun"
                                                                onchange="this.form.submit()">

                                                                <option value="">
                                                                    Semua Tahun
                                                                </option>

                                                                <% tahunList.forEach(t => { %>

                                                                    <option
                                                                        value="<%= t.tahun %>"
                                                                        <%= String(filters.tahun) === String(t.tahun) ? 'selected' : '' %>>

                                                                        <%= t.tahun %>

                                                                    </option>

                                                                <% }) %>

                                                            </select>

                                                        </div>


                                                        <!-- FILTER BULAN -->
                                                        <div class="col-md-4 mb-3">

                                                            <label for="filter_bulan">
                                                                Bulan
                                                            </label>

                                                            <select
                                                                class="form-control"
                                                                id="filter_bulan"
                                                                name="bulan"
                                                                onchange="this.form.submit()">

                                                                <option value="">
                                                                    Semua Bulan
                                                                </option>

                                                                <% for (let i = 1; i <= 12; i++) { %>

                                                                    <option
                                                                        value="<%= i %>"
                                                                        <%= String(filters.bulan) === String(i) ? 'selected' : '' %>>

                                                                        <%= namaBulan[i] %>

                                                                    </option>

                                                                <% } %>

                                                            </select>

                                                        </div>


                                                        <!-- RESET -->
                                                        <div class="col-md-4 mb-3 d-flex align-items-end">

                                                            <a
                                                                href="/periode/rekap"
                                                                class="btn btn-light">

                                                                <i class="bi-arrow-counterclockwise"></i>
                                                                Reset Filter

                                                            </a>

                                                        </div>

                                                    </div>

                                                </form>

                                            </div>

                                        </div>


                                        <!-- TABEL REKAP -->
                                        <div class="d-flex justify-content-between align-items-center mb-3">

                                            <h5 class="mb-0">
                                                Daftar Rekap Periode
                                            </h5>

                                            <span class="text-muted">
                                                Total <strong><%= data.length %></strong> periode
                                            </span>

                                        </div>


                                        <div class="table-responsive">

                                            <table class="table table-striped table-hover table-bordered">

                                                <thead>

                                                    <tr>
                                                        <th>No</th>
                                                        <th>Tahun</th>
                                                        <th>Bulan</th>
                                                        <th>No. Periode</th>
                                                        <th>Uang Muka</th>
                                                        <th>Total Fee ONSITE</th>
                                                        <th>Jumlah Transaksi</th>
                                                        <th>Sisa Anggaran</th>
                                                        <th>Status Anggaran</th>
                                                        <th>Aksi</th>
                                                    </tr>

                                                </thead>


                                                <tbody>

                                                    <% if (data.length > 0) { %>

                                                        <% data.forEach((item, index) => { %>

                                                            <%
                                                                const sisa = Number(item.sisa_anggaran || 0);
                                                                const jumlah = Number(item.jumlah_transaksi || 0);
                                                            %>

                                                            <tr>

                                                                <!-- NOMOR -->
                                                                <td>
                                                                    <%= index + 1 %>
                                                                </td>


                                                                <!-- TAHUN -->
                                                                <td>
                                                                    <%= item.tahun %>
                                                                </td>


                                                                <!-- BULAN -->
                                                                <td>
                                                                    <%= namaBulan[Number(item.bulan)] || item.bulan %>
                                                                </td>


                                                                <!-- NOMOR PERIODE -->
                                                                <td>
                                                                    <strong>
                                                                        Periode <%= item.nomor_periode %>
                                                                    </strong>
                                                                </td>


                                                                <!-- UANG MUKA -->
                                                                <td>
                                                                    <%= formatRupiah(item.uang_muka) %>
                                                                </td>


                                                                <!-- TOTAL FEE -->
                                                                <td>
                                                                    <strong>
                                                                        <%= formatRupiah(item.total_fee) %>
                                                                    </strong>
                                                                </td>


                                                                <!-- JUMLAH TRANSAKSI -->
                                                                <td class="text-center">
                                                                    <%= jumlah %>
                                                                </td>


                                                                <!-- SISA ANGGARAN -->
                                                                <td>

                                                                    <strong class="<%= sisa < 0 ? 'text-danger' : (sisa === 0 ? 'text-warning' : 'text-success') %>">

                                                                        <%= formatRupiah(item.sisa_anggaran) %>

                                                                    </strong>

                                                                </td>


                                                                <!-- STATUS ANGGARAN -->
                                                                <td>

                                                                    <% if (sisa < 0) { %>

                                                                        <span class="badge bg-danger">
                                                                            Melebihi Anggaran
                                                                        </span>

                                                                    <% } else if (sisa === 0) { %>

                                                                        <span class="badge bg-warning text-dark">
                                                                            Saldo Habis
                                                                        </span>

                                                                    <% } else if (jumlah === 0) { %>

                                                                        <span class="badge bg-secondary">
                                                                            Belum Ada Pencairan
                                                                        </span>

                                                                    <% } else { %>

                                                                        <span class="badge bg-success">
                                                                            Saldo Tersedia
                                                                        </span>

                                                                    <% } %>

                                                                </td>
                                                                <!-- AKSI DETAIL -->
                                                                <td>
                                                                    <a
                                                                        href="/periode/detail/<%= item.id_periode %>"
                                                                        class="btn btn-sm btn-info">

                                                                        <i class="bi-eye"></i>
                                                                        Detail

                                                                    </a>
                                                                </td>

                                                            </tr>

                                                        <% }) %>

                                                    <% } else { %>

                                                        <tr>

                                                            <td colspan="10" class="text-center">

                                                                Belum ada data periode yang sesuai dengan filter.

                                                            </td>

                                                        </tr>

                                                    <% } %>

                                                </tbody>

                                            </table>

                                        </div>


                                        <!-- KETERANGAN -->
                                        <div class="alert alert-info mt-3">

                                            <strong>Keterangan perhitungan:</strong>

                                            <ul class="mb-0 mt-2">

                                                <li>
                                                    Total Fee ONSITE merupakan jumlah nominal transaksi
                                                    dengan status pembayaran ONSITE pada periode terkait.
                                                </li>

                                                <li>
                                                    Transaksi OFFSITE tidak dimasukkan dalam perhitungan.
                                                </li>

                                                <li>
                                                    Sisa Anggaran dihitung dari Uang Muka dikurangi Total Fee ONSITE.
                                                </li>

                                                <li>
                                                    Saldo anggaran diharapkan tetap lebih dari Rp0.
                                                </li>

                                            </ul>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

<%- include('../partials/__foot.ejs') %>

</body>
</html>
