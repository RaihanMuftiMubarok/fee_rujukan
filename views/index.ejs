        body {
            overflow-x: hidden;

        }

        .dropdown-sid {
            position: static !important;
        }

        @media (min-width: 992px) {
            .dropdown-sid {
                position: absolute !important;
                right: 0;
                left: auto;
            }
        }

        .animate-scroll {
            display: inline-block;
            white-space: nowrap;
            position: relative;
            animation: scrollText 20s linear infinite;
        }

        @keyframes scrollText {
            0% {
                transform: translateX(100%);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        /* Hentikan animasi saat di-hover */
        .animate-scroll:hover {
            animation-play-state: paused;
        }

        /* Batasi tinggi agar tidak terlalu besar */
        .header-carousel {
            max-height: 500px;
        }

        .carousel-image-wrapper {
            width: 100%;
            height: 500px;
            /* atur tinggi seragam */
            overflow: hidden;
        }

        .carousel-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            /* gambar akan menyesuaikan proporsi tanpa distorsi */
        }

        @media (max-width: 768px) {
            .carousel-image-wrapper {
                height: 300px;
                /* tinggi lebih kecil di layar kecil */
            }
        }

        /* berita */
        .berita-img {
            width: 100%;
            height: 220px;
            /* tinggi seragam */
            object-fit: cover;
            /* biar crop rapi, tidak melebar aneh */
            border-radius: 5px;
        }

        .berita-judul {
            min-height: 50px;
            /* tinggi minimum biar sejajar */
            max-height: 50px;
            /* paksa tetap sama */
            overflow: hidden;
            /* sembunyikan yang lebih */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            /* maksimal 2 baris */
            -webkit-box-orient: vertical;
        }

        .course-item {
            height: 100%;
            /* biar semua card stretch sama */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }



        /* team */
        .team-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            /* posisi tombol + scroll container center */
            gap: 10px;
            position: relative;
        }

        .team-scroll {
            display: flex;
            gap: 1rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            padding-bottom: 10px;
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
        }

        .team-scroll::-webkit-scrollbar {
            display: none;
        }

        .team-item {
            flex: 0 0 calc((100% - (1rem * 3)) / 4);
            /* default desktop: 4 card */
            scroll-snap-align: start;
            border-radius: 8px;
        }

        .team-item .overflow-hidden {
            width: 100%;
            height: 250px;
            /* tinggi seragam untuk semua card */
            overflow: hidden;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
        }

        .team-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            /* potong gambar biar penuh */
            display: block;
        }



        /* Mobile: 2 card penuh */
        @media (max-width: 768px) {
            .team-item {
                flex: 0 0 calc((100% - 1rem) / 2);
            }
        }

        .scroll-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            background: rgba(0, 0, 0, 0.5);
            color: white;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 18px;
            border-radius: 50%;
        }

        .scroll-btn.left {
            left: -15px;
        }

        .scroll-btn.right {
            right: -15px;
        }
    </style>
