    <script>
        document.querySelectorAll('.team-wrapper').forEach((wrapper) => {
            const scrollContainer = wrapper.querySelector('.team-scroll');
            const btnLeft = wrapper.querySelector('.scroll-btn.left');
            const btnRight = wrapper.querySelector('.scroll-btn.right');
        
            if (!scrollContainer || !btnLeft || !btnRight) return;
        
            // Hitung lebar card
            function getCardWidth() {
                const card = scrollContainer.querySelector('.team-item');
                if (!card) return 0;
                const style = window.getComputedStyle(card);
                return card.offsetWidth + parseInt(style.marginRight);
            }
        
            let cardWidth = getCardWidth();
        
            // Fungsi geser kanan
            function scrollNext() {
                if (scrollContainer.scrollLeft + scrollContainer.clientWidth >= scrollContainer.scrollWidth - 5) {
                    scrollContainer.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    scrollContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
                }
            }
        
            // Tombol kiri & kanan
            btnLeft.addEventListener('click', () => {
                if (scrollContainer.scrollLeft <= 0) {
                    scrollContainer.scrollTo({ left: scrollContainer.scrollWidth, behavior: 'smooth' });
                } else {
                    scrollContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
                }
            });
        
            btnRight.addEventListener('click', scrollNext);
        
            // Auto scroll
            let autoScroll = setInterval(scrollNext, 3000);
        
            // Pause saat hover
            scrollContainer.addEventListener('mouseenter', () => clearInterval(autoScroll));
            scrollContainer.addEventListener('mouseleave', () => {
                autoScroll = setInterval(scrollNext, 3000);
            });
        
            // Recalculate saat resize
            window.addEventListener('resize', () => {
                cardWidth = getCardWidth();
            });
        });
        </script>
        

