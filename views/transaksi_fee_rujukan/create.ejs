<%- include('../partials/__head.ejs') %>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet">

    <style>
        .select2-container {
            width: 100% !important;
        }

        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 4px;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
    </style>
    <% const namaBulan=[ '' , 'Januari' , 'Februari' , 'Maret' , 'April' , 'Mei' , 'Juni' , 'Juli' , 'Agustus'
        , 'September' , 'Oktober' , 'November' , 'Desember' ]; %>

        <body>
            <div class="container-scroller">

                <%- include('../partials/__nav.ejs') %>

                    <section class="pc-container">
                        <div class="pc-content">

                            <div class="main-panel w-100">
                                <div class="content-wrapper">

                                    <div class="col-md-12 grid-margin stretch-card">
                                        <div class="card">
                                            <div class="card-body">

                                                <h4 class="card-title">
                                                    Input Transaksi Fee Rujukan Pasien
                                                </h4>

                                                <p class="card-description">
                                                    Masukkan data pasien, rujukan, dan status pembayaran fee.
                                                </p>

                                                <!-- Flash Error -->
                                                <% if (typeof error !=='undefined' && error.length> 0) { %>
                                                    <% error.forEach(msg=> { %>
                                                        <div class="alert alert-danger alert-dismissible fade show">
                                                            <%= msg %>
                                                                <button type="button" class="btn-close"
                                                                    data-bs-dismiss="alert">
                                                                </button>
                                                        </div>
                                                        <% }) %>
                                                            <% } %>

                                                                <form action="/transaksi_fee_rujukan/store"
                                                                    method="POST" class="forms-sample">

                                                                    <!-- DATA PASIEN -->
                                                                    <h5 class="text-primary mb-3">Data Pasien</h5>

                                                                    <div class="row">

                                                                        <div class="form-group col-md-6 mb-3">
                                                                            <label for="nama_pasien">
                                                                                Nama Pasien
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <input type="text" class="form-control"
                                                                                id="nama_pasien" name="nama_pasien"
                                                                                placeholder="Masukkan nama pasien"
                                                                                maxlength="150" required>
                                                                        </div>

                                                                        <div class="form-group col-md-6 mb-3">
                                                                            <label for="no_rm">
                                                                                No. Rekam Medis (RM)
                                                                            </label>

                                                                            <input type="text" class="form-control"
                                                                                id="no_rm" name="no_rm"
                                                                                placeholder="Contoh: 135600"
                                                                                maxlength="50">
                                                                        </div>

                                                                    </div>

                                                                    <div class="row">

                                                                        <!-- Status Pasien -->
                                                                        <div class="form-group col-md-4 mb-3">
                                                                            <label for="status_pasien">
                                                                                Status Pasien
                                                                            </label>

                                                                            <select class="form-control"
                                                                                id="status_pasien" name="status_pasien">

                                                                                <option value="BPJS" selected>BPJS
                                                                                </option>
                                                                                <option value="UMUM">UMUM</option>
                                                                                <option value="BPP">BPP</option>

                                                                            </select>
                                                                        </div>

                                                                        <!-- Tanggal MRS -->
                                                                        <div class="form-group col-md-4 mb-3">
                                                                            <label for="tanggal_mrs">
                                                                                Tanggal Masuk (MRS)
                                                                            </label>

                                                                            <input type="date" class="form-control"
                                                                                id="tanggal_mrs" name="tanggal_mrs">
                                                                        </div>

                                                                        <!-- Ruang -->
                                                                        <div class="form-group col-md-4 mb-3">
                                                                            <label for="id_ruang">
                                                                                Ruang Perawatan
                                                                            </label>

                                                                            <select class="form-control" id="id_ruang"
                                                                                name="id_ruang">

                                                                                <option value="" selected>
                                                                                    -- Pilih Ruang --
                                                                                </option>

                                                                                <% ruang.forEach(r=> { %>
                                                                                    <option value="<%= r.id_ruang %>">
                                                                                        <%= r.nama_ruang %>
                                                                                    </option>
                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                    </div>

                                                                    <hr class="my-4">

                                                                    <!-- DATA RUJUKAN -->
                                                                    <h5 class="text-primary mb-3">Data Rujukan</h5>

                                                                    <div class="row">

                                                                        <!-- Perujuk -->
                                                                        <div class="form-group col-md-6 mb-3">
                                                                            <label for="id_perujuk">
                                                                                Nama Perujuk
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <select
                                                                                class="form-control searchable-select"
                                                                                id="id_perujuk" name="id_perujuk"
                                                                                data-placeholder="Ketik nama perujuk untuk mencari..."
                                                                                required>

                                                                                <option value="" selected disabled>
                                                                                    -- Pilih Perujuk dari Master --
                                                                                </option>

                                                                                <% perujuk.forEach(p=> { %>
                                                                                    <option value="<%= p.id_perujuk %>">
                                                                                        <%= p.nama_perujuk %> (<%=
                                                                                                p.jenis_perujuk %>)
                                                                                    </option>
                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                        <!-- Diagnosis -->
                                                                        <div class="form-group col-md-6 mb-3">
                                                                            <label for="id_dx">
                                                                                Diagnosa (DX)
                                                                            </label>

                                                                            <select class="form-control" id="id_dx"
                                                                                name="id_dx">

                                                                                <option value="" selected>
                                                                                    -- Pilih Diagnosis --
                                                                                </option>

                                                                                <% dx.forEach(d=> { %>
                                                                                    <option value="<%= d.id_dx %>">
                                                                                        <%= d.kode_dx %> - <%=
                                                                                                d.nama_kategori %>
                                                                                    </option>
                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                    </div>

                                                                    <div class="row">

                                                                        <!-- Nominal Fee -->
                                                                        <div class="form-group col-md-6 mb-3">
                                                                            <label for="nominal_fee">
                                                                                Nominal Fee (Rp)
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <input type="number" class="form-control"
                                                                                id="nominal_fee" name="nominal_fee"
                                                                                placeholder="Contoh: 250000" min="1"
                                                                                step="1" required>
                                                                        </div>

                                                                        <!-- Petugas Penerima -->
                                                                        <div class="form-group col-md-6 mb-3">
                                                                            <label for="id_petugas_penerima">
                                                                                Petugas Penerima Rujukan
                                                                            </label>

                                                                            <select class="form-control"
                                                                                id="id_petugas_penerima"
                                                                                name="id_petugas_penerima">

                                                                                <option value="" selected>
                                                                                    -- Pilih Petugas Penerima --
                                                                                </option>

                                                                                <% petugas.forEach(pt=> { %>
                                                                                    <option
                                                                                        value="<%= pt.id_petugas %>">
                                                                                        <%= pt.nama_petugas %>
                                                                                    </option>
                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                    </div>

                                                                    <hr class="my-4">

                                                                    <!-- STATUS PEMBAYARAN -->
                                                                    <h5 class="text-primary mb-3">
                                                                        Status Pembayaran & Pencairan Fee
                                                                    </h5>

                                                                    <div class="row">

                                                                        <!-- Status Pembayaran -->
                                                                        <div class="form-group col-md-4 mb-3">
                                                                            <label for="status_pembayaran">
                                                                                Pilih Alur Pembayaran
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <select class="form-control"
                                                                                id="status_pembayaran"
                                                                                name="status_pembayaran" required>

                                                                                <option value="OFFSITE" selected>
                                                                                    Belum Dicairkan (OFFSITE)
                                                                                </option>

                                                                                <option value="ONSITE">
                                                                                    Cairkan Sekarang (ONSITE)
                                                                                </option>

                                                                            </select>
                                                                        </div>

                                                                        <!-- Periode -->
                                                                        <div class="form-group col-md-4 mb-3 onsite-field"
                                                                            style="display: none;">

                                                                            <label for="id_periode">
                                                                                Pilih Periode Anggaran
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <select class="form-control" id="id_periode"
                                                                                name="id_periode">

                                                                                <option value="" selected disabled>
                                                                                    -- Pilih Periode --
                                                                                </option>

                                                                                <% periode.forEach(pr=> { %>

                                                                                    <option
                                                                                        value="<%= pr.id_periode %>">

                                                                                        Tahun <%= pr.tahun %> -

                                                                                            <%= namaBulan[Number(pr.bulan)]
                                                                                                || pr.bulan %>

                                                                                                (Periode <%=
                                                                                                    pr.nomor_periode %>)

                                                                                    </option>

                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                        <!-- Petugas Pencair -->
                                                                        <div class="form-group col-md-4 mb-3 onsite-field"
                                                                            style="display: none;">

                                                                            <label for="id_petugas_pencair">
                                                                                Petugas yang Mencairkan
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <select class="form-control"
                                                                                id="id_petugas_pencair"
                                                                                name="id_petugas_pencair">

                                                                                <option value="" selected disabled>
                                                                                    -- Pilih Petugas Pencair --
                                                                                </option>

                                                                                <% petugas.forEach(pt=> { %>

                                                                                    <option
                                                                                        value="<%= pt.id_petugas %>">
                                                                                        <%= pt.nama_petugas %>
                                                                                    </option>

                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                    </div>

                                                                    <!-- Peringatan jika master periode kosong -->
                                                                    <% if (periode.length===0) { %>
                                                                        <div class="alert alert-warning">
                                                                            Belum ada periode anggaran.
                                                                            Buat periode terlebih dahulu untuk melakukan
                                                                            pencairan.
                                                                        </div>
                                                                        <% } %>

                                                                            <!-- Keterangan -->
                                                                            <div class="form-group mb-3">
                                                                                <label for="keterangan">
                                                                                    Keterangan / Catatan
                                                                                </label>

                                                                                <textarea class="form-control"
                                                                                    id="keterangan" name="keterangan"
                                                                                    rows="2"
                                                                                    placeholder="Catatan tambahan (opsional)"></textarea>
                                                                            </div>

                                                                            <!-- Tombol -->
                                                                            <button type="submit"
                                                                                class="btn btn-primary mr-2">
                                                                                Simpan Transaksi
                                                                            </button>

                                                                            <a href="/transaksi_fee_rujukan"
                                                                                class="btn btn-light">
                                                                                Batal
                                                                            </a>

                                                                </form>

                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </section>

            </div>


            <!-- JavaScript tampil/sembunyi field ONSITE -->
            <script>
                document.addEventListener('DOMContentLoaded', function () {

                    const statusSelect = document.getElementById('status_pembayaran');

                    const onsiteFields = document.querySelectorAll('.onsite-field');

                    const periodeSelect = document.getElementById('id_periode');

                    const pencairSelect = document.getElementById('id_petugas_pencair');

                    function toggleOnsiteFields() {

                        const isOnsite = statusSelect.value === 'ONSITE';

                        onsiteFields.forEach(field => {
                            field.style.display = isOnsite ? '' : 'none';
                        });

                        periodeSelect.required = isOnsite;
                        pencairSelect.required = isOnsite;
                    }

                    statusSelect.addEventListener('change', toggleOnsiteFields);

                    // Menyesuaikan tampilan ketika halaman pertama kali dibuka.
                    toggleOnsiteFields();

                });
            </script>

            <%- include('../partials/__foot.ejs') %>

        </body>

        </html>