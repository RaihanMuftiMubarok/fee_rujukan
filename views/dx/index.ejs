<%- include('../partials/__head.ejs') %>

    <body>
        <div class="container-scroller">
            <!-- partial:partials/_navbar.html -->
            <%- include('../partials/__nav.ejs') %>
                <!-- partial -->
                <section class="pc-container">
                    <div class="pc-content">
                        
                        <div class="main-panel">
                            <div class="content-wrapper">
                                <div class="container mt-5">
                                    <div class="row">
                                        <div class="col-lg-12 grid-margin stretch-card">
                                            <div class="card">
                                                <div class="card-body">
                                                    <h4 class="card-title">Data Diagnosa</h4>
                                                    <a href="/dx/create" class="btn btn-sm btn-info mb-3"> <i class="bi bi-plus-circle"></i> Tambah
                                                        Diagnosa</a>
                                                    <div class="table-responsive">
                                                        <table class="table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>No</th>
                                                                    
                                                                    <th>Kode DX</th>
                                                                    <th>Nama Kategori</th>
                                                                    <th>Keterangan</th>
                                                                    <th>status</th>
                                                                    
                                                                    
                                                                    <th colspan="2">Aksi</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% for(var i=0; i < data.length; i++) { %>
                                                                    <tr>
                                                                        <th scope="row">
                                                                            <%= (i + 1) %>
                                                                        </th>

                                                                        <td>
                                                                            <%= data[i].kode_dx %>
                                                                        </td>
                                                                        <td>
                                                                            <%= data[i].nama_kategori %>
                                                                        </td>
                                                                        <td>
                                                                            <%= data[i].keterangan %>
                                                                        </td>
                                                                        
                                                                        <td>
                                                                            <%= data[i].status_aktif %>
                                                                        </td>
                                                                        <td>
                                                                            <a href="/dx/edit/<%= data[i].id_dx %>"
                                                                                class="btn btn-sm btn-warning">
                                                                                <i class="ti ti-edit"></i>
                                                                            </a>
                                                                            <!-- Tombol untuk trigger modal -->
                                                                            <button type="button"
                                                                                class="btn btn-sm btn-danger"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#deleteModal<%= data[i].id_dx %>">
                                                                                <i class="ti ti-trash"></i>
                                                                            </button>
                                                                        </td>
                                                                        <!-- Modal Konfirmasi -->
                                                                        <div class="modal fade"
                                                                            id="deleteModal<%= data[i].id_dx %>"
                                                                            tabindex="-1"
                                                                            aria-labelledby="deleteModalLabel<%= data[i].id_dx %>"
                                                                            aria-hidden="true">
                                                                            <div class="modal-dialog">
                                                                                <div class="modal-content">
                                                                                    <div class="modal-header">
                                                                                        <h5 class="modal-title"
                                                                                            id="deleteModalLabel<%= data[i].id_dx %>">
                                                                                            Konfirmasi Hapus</h5>
                                                                                        <button type="button"
                                                                                            class="btn-close"
                                                                                            data-bs-dismiss="modal"
                                                                                            aria-label="Close"></button>
                                                                                    </div>
                                                                                    <div class="modal-body">
                                                                                        Apakah Anda yakin ingin
                                                                                        menghapus <b>
                                                                                            <%= data[i].kode_dx %>
                                                                                        </b> dari daftar?
                                                                                    </div>
                                                                                    <div class="modal-footer">
                                                                                        <button type="button"
                                                                                            class="btn btn-secondary"
                                                                                            data-bs-dismiss="modal">Batal</button>
                                                                                        <a href="/dx/delete/<%= data[i].id_dx %>"
                                                                                            class="btn btn-danger">Ya,
                                                                                            Hapus</a>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </tr>
                                                                    <% } %>
                                                            </tbody>
                                                        </table>
                                                        <div class="d-flex justify-content-start mt-3">

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- content-wrapper ends -->
                    </div>
                </section>
                    <!-- container-scroller ends -->
                    <%- include('../partials/__foot.ejs') %>
    </body>