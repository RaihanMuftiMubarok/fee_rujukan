<%- include('../partials/__head.ejs') %>
    <%- include('../partials/__nav.ejs', { user: user }) %>

        <body>
            <div class="container py-5">
                <!-- HEADER -->
                <div class="row align-items-center mb-5">
                    <div class="col-md-8">
                        <h2 class="fw-bold">Selamat Datang di Halaman Admin</h2>
                        <p class="text-muted">
                            Website Resmi Desa Kertasada
                        </p>
                        <p> Sumber informasi terbaru tentang pemerintahan di Desa Kertasada</p>
                    </div>
                    <div class="col-md-4 text-md-end text-center">
                        <img src="/images/logo.png" alt="Logo Desa" class="img-fluid" style="max-height:100%;">
                    </div>
                </div>

                <!-- STATISTIK PENDUDUK -->
                <h3 class="fw-bold mb-4 text-success">Jumlah Penduduk dan Kepala Keluarga</h3>
                <div class="row g-4">

                    <!-- TOTAL PENDUDUK -->
                    <div class="col-md-6 col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex align-items-center">
                                <img src="/images/total_penduduk.svg" alt="Total Penduduk" class="me-3"
                                    style="width:8rem; height:8rem;">
                                <div>
                                    <h5 class="mb-1 text-muted">TOTAL PENDUDUK</h5>
                                    <h3 class="fw-bold text-success">
                                        <%= totalPenduduk %> Jiwa
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KEPALA KELUARGA -->
                    <div class="col-md-6 col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex align-items-center">
                                <img src="/images/kepala_keluarga.svg" alt="Kepala Keluarga" class="me-3"
                                    style="width:8rem; height:8rem;">
                                <div>
                                    <h5 class="mb-1 text-muted">KEPALA KELUARGA</h5>
                                    <h3 class="fw-bold text-success">
                                        <%= kepalaKeluarga %> KK
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PEREMPUAN -->
                    <div class="col-md-6 col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex align-items-center">
                                <img src="/images/perempuan.svg" alt="Perempuan" class="me-3"
                                    style="width:8rem; height:8rem;">
                                <div>
                                    <h5 class="mb-1 text-muted">PEREMPUAN</h5>
                                    <h3 class="fw-bold text-success">
                                        <%= jumlahPerempuan %> Jiwa
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LAKI-LAKI -->
                    <div class="col-md-6 col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body d-flex align-items-center">
                                <img src="/images/laki-laki.svg" alt="Laki-Laki" class="me-3"
                                    style="width:8rem; height:8rem;">
                                <div>
                                    <h5 class="mb-1 text-muted">LAKI-LAKI</h5>
                                    <h3 class="fw-bold text-success">
                                        <%= jumlahLaki %> Jiwa
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Piramida Penduduk -->
              <div class="container mt-5">
                  <h3 class="fw-bold mb-4 text-success">Berdasarkan Kelompok Umur </h3>
                  <div class="card shadow-sm border-0">
                    <div class="card-body">
                      <canvas id="piramidaChart" ></canvas>
                    </div>
                  </div>
                </div>
                <div class="container mt-5">
                    <h3 class="fw-bold mb-4 text-success">Berdasarkan Pendidikan</h3>
                    
                    <canvas id="pendidikanChart"></canvas>
                </div>
                <div class="container mt-5">
                  <h3 class="fw-bold mb-4 text-success">Berdasarkan Pekerjaan</h3>
                  <div class="row">
                    <!-- KIRI: TABEL -->
                    <div class="col-lg-6">
                      <!-- Tambahkan div pembungkus untuk scroll -->
                      <div style="max-height: 300px; overflow-y:auto;">
                        <table class="table table-bordered mb-0">
                          <thead class="table-success sticky-top">
                            <tr>
                              <th>Jenis Pekerjaan</th>
                              <th>Jumlah</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% tabelPekerjaan.forEach(function(item){ %>
                              <tr>
                                <td><%= item.pekerjaan %></td>
                                <td><%= item.jumlah %></td>
                              </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                
                    <!-- KANAN: 4 CARD -->
                    <div class="col-lg-6">
                      <div class="row g-3">
                        <% top4.forEach(function(item){ %>
                          <div class="col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                              <div class="card-body text-center">
                                <h6 class="fw-bold mb-2"><%= item.pekerjaan %></h6>
                                <h2 class="fw-bold text-success"><%= item.jumlah %></h2>
                              </div>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                </div>
                
            </div>

            <!-- Core JS -->
            <!-- build:js assets/vendor/js/core.js -->
            <script src="/sneat/assets/vendor/libs/jquery/jquery.js"></script>
            <script src="/sneat/assets/vendor/libs/popper/popper.js"></script>
            <script src="/sneat/assets/vendor/js/bootstrap.js"></script>
            <script src="/sneat/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>

            <script src="/sneat/assets/vendor/js/menu.js"></script>
            <!-- endbuild -->

            <!-- Vendors JS -->
            <script src="/sneat/assets/vendor/libs/apex-charts/apexcharts.js"></script>

            <!-- Main JS -->
            <script src="/sneat/assets/js/main.js"></script>

            <!-- Page JS -->
            <script src="/sneat/assets/js/dashboards-analytics.js"></script>

            <!-- Place this tag in your head or just before your close body tag. -->
            <script async defer src="https://buttons.github.io/buttons.js"></script>
            <!-- Bootstrap & Chart.js CDN -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

            <script>
              const labels = <%- JSON.stringify(labels) %>;
              const laki = <%- JSON.stringify(laki) %>;
              const perempuan = <%- JSON.stringify(perempuan) %>;
              
              console.log(labels, laki, perempuan); // cek di console browser
              
              new Chart(document.getElementById('piramidaChart'), {
                type: 'bar',
                data: {
                  labels: labels,
                  datasets: [
                    {
                      label: 'Laki-Laki',
                      data: laki,
                      backgroundColor: '#4caf50'
                    },
                    {
                      label: 'Perempuan',
                      data: perempuan,
                      backgroundColor: '#00bcd4'
                    }
                  ]
                },
                options: {
                  indexAxis: 'y',
                  scales: {
                    x: {
                      stacked: true,
                      ticks: {
                        callback: function(value) {
                          return Math.abs(value);
                        }
                      }
                    },
                    y: {
                      stacked: true
                    }
                  }
                }
              });
              </script>
            <script>
                const pendidikanLabels = <%- pendidikanLabels %>;
                const pendidikanCounts = <%- pendidikanCounts %>;
              
                const ctx = document.getElementById('pendidikanChart').getContext('2d');
                new Chart(ctx, {
                  type: 'bar',
                  data: {
                    labels: pendidikanLabels,
                    datasets: [{
                      label: 'Jumlah Penduduk',
                      data: pendidikanCounts,
                      backgroundColor: [
                        
                        '#4caf50'
                      ]
                    }]
                  },
                  options: {
                    responsive: true,
                    plugins: {
                      legend: { display: false }
                    },
                    scales: {
                      y: { beginAtZero: true, title: { display: true, text: 'Jumlah Penduduk' } },
                      x: { title: { display: true, text: 'Tingkat Pendidikan' } }
                    }
                  }
                });
              </script>
              
            <%- include('../partials/__foot.ejs') %>